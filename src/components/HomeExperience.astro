---
import PostCards from './PostCards.astro';
import UrbanScene from './UrbanScene.astro';
import type { Lang, Post } from '../lib/content';
interface Props { lang: Lang; posts: Post[]; }
const { lang, posts } = Astro.props;
const ko = lang === 'ko';
---
<section class="city-prologue" aria-label={ko ? '도시를 바라보는 배달기사' : 'A delivery rider looking out over the city'}>
 <div class="city-stage">
  <UrbanScene priority />
  <div class="city-title"><h1>{ko ? <>딸배<br />시뮬레이터</> : <>BROKE RIDER<br />SIMULATOR</>}</h1><p>{ko ? '팀 메추리알이 만드는 배달 게임' : 'A delivery game by Team Mechureal'}</p></div>
  <a class="city-scroll" href="#the-game">{ko ? '도시 속으로' : 'Into the city'} <span aria-hidden="true">↓</span></a>
 </div>
</section>
<section class="game-introduction" id="the-game">
 <p class="game-lede">{ko ? <>누군가의 저녁을 싣고,<br />익숙한 도시를 달립니다.</> : <>Someone’s dinner.<br />Your way through the city.</>}</p>
 <div class="intro-columns"><p>{ko ? '딸배 시뮬레이터는 개발자의 실제 배달 경험을 바탕으로 만드는 1인칭 배달 게임입니다. 실제 지도 데이터로 구현한 도시에서 주문을 받고, 길을 찾아 음식을 배달합니다.' : 'BROKE RIDER SIMULATOR is a first-person delivery game born from the developer’s own delivery work. Take orders, find your route, and keep moving through streets built from real map data.'}</p><div><p>{ko ? '배달 수입으로 생활비를 마련하고 빚을 갚습니다. 배달 중에 마주치는 일들도 게임에 담고 있습니다. 현재 개발 중으로, 출시일은 미정이며 아직 공개 버전은 없습니다.' : 'Earn your way through bills and debt, with the things that happen along the way becoming part of the game. Currently in development; no release date or public build yet.'}</p></div></div>
 <div class="intro-actions"><a class="button" href={`/${lang}/games/broke-rider-simulator/`}>{ko ? '게임 자세히 보기' : 'Explore the game'} <span aria-hidden="true">↗</span></a></div>
</section>
<section class="city-interlude" aria-label={ko ? '해 질 무렵의 도시 풍경' : 'The city at dusk'}><div><h2>{ko ? <>오늘도,<br />도시 어딘가에서.</> : <>Another day.<br />Somewhere in the city.</>}</h2><p>{ko ? '실제 지도 데이터로 게임 속 거리를 만들고 있습니다. 도시를 구현하는 과정은 개발 일지에 기록합니다.' : 'A route on the map becomes a street in the game. Our devlog follows the work of bringing a real city into play.'}</p><a class="text-link" href={`/${lang}/devlog/`}>{ko ? '개발 과정 읽기' : 'Read about development'} →</a></div><figure><img src="/images/urban-dusk/skyline.webp" width="1536" height="1024" alt={ko ? '살구빛 하늘 아래 겹겹이 이어지는 도시 건물 콘셉트 아트' : 'Concept art of layered city buildings beneath an apricot sky'} loading="lazy" /></figure></section>
<section class="development-journal"><div class="section-head"><h2>{ko ? '만드는 동안의 기록' : 'Notes from development'}</h2><a class="text-link" href={`/${lang}/devlog/`}>{ko ? '전체 개발 일지' : 'All notes'} ↗</a></div><PostCards {posts} {lang} /></section>
<section class="studio-signoff"><h2>Team Mechureal</h2><p>{ko ? '만들고 싶은 게임을 직접 만드는 작은 팀입니다.' : 'A small team making the games we want to play.'}</p><div><a href={`/${lang}/about/`}>{ko ? '팀 소개' : 'About us'}</a><a href={`/${lang}/contact/`}>{ko ? '연락하기' : 'Get in touch'}</a></div></section>
<script>
import { cityMotion } from '../lib/scroll-motion';
const scene = document.querySelector<HTMLElement>('.city-prologue');
if (scene) {
 const reduced = matchMedia('(prefers-reduced-motion: reduce)');
 let raf = 0;
 const paint = () => {
  raf = 0;
  const header = document.querySelector<HTMLElement>('.site-header')?.offsetHeight ?? 64;
  const frame = cityMotion(scene.getBoundingClientRect().top, scene.offsetHeight, header);
  scene.style.setProperty('--far-y', `${frame.far}px`);
  scene.style.setProperty('--mid-y', `${frame.middle}px`);
  scene.style.setProperty('--near-y', `${frame.near}px`);
  scene.style.setProperty('--rider-y', `${frame.rider}px`);
  scene.style.setProperty('--title-opacity', String(frame.title));
 };
 const schedule = () => { if (!raf && !reduced.matches) raf = requestAnimationFrame(paint); };
 const configure = () => {
  scene.classList.toggle('parallax-ready', !reduced.matches);
  if (reduced.matches && raf) { cancelAnimationFrame(raf); raf = 0; }
  schedule();
 };
 addEventListener('scroll', schedule, { passive:true });
 addEventListener('resize', schedule, { passive:true });
 reduced.addEventListener('change', configure);
 configure();
}
</script>
