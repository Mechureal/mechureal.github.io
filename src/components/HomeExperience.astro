---
import PostCards from './PostCards.astro';
import type { Lang, Post } from '../lib/content';
interface Props { lang: Lang; posts: Post[]; }
const { lang, posts } = Astro.props;
const ko = lang === 'ko';
---
<section class="egg-story" aria-label={ko ? '알을 깨면 나오는 게임' : 'Crack open our games'}>
  <div class="egg-stage">
    <div class="studio-intro">
      <h1>{ko ? <>게임 만드는<br /><em>메추리알.</em></> : <>We make games.<br /><em>We’re Mechureal.</em></>}</h1>
      <p>{ko ? <>작은 알 속에서 무슨 일이 벌어지는지.<br />조금만 내려가면 알게 됩니다.</> : <>There’s something going on inside this egg.<br />Scroll a little. Find out.</>}</p>
      <a href="#games" class="round-link">{ko ? '알 속으로' : 'Crack it open'}<span aria-hidden="true">↓</span></a>
    </div>
    <div class="egg-object" aria-hidden="true"><div class="egg-shadow"></div><img class="egg-piece egg-upper" src="/images/rebrand/quail-egg.webp" alt="" width="800" height="1200" fetchpriority="high" /><img class="egg-piece egg-lower" src="/images/rebrand/quail-egg.webp" alt="" width="800" height="1200" fetchpriority="high" /></div>
    <div class="inner-world" aria-hidden="true"><img src="/images/rebrand/delivery-world.webp" width="1536" height="1024" alt="" /><strong>{ko ? '배달 왔습니다.' : 'Your delivery is here.'}</strong><small>{ko ? '콘셉트 아트 · 실제 게임 화면이 아닙니다' : 'Concept art · Not an in-game screenshot'}</small></div>
    <div class="hero-foot"><span>Independent game collective</span><span>{ko ? '스크롤해서 깨워주세요' : 'A little scroll goes a long way'} ↓</span></div>
  </div>
</section>
<section class="game-world" id="games">
  <div class="game-title-row"><h2>{ko ? <>딸배<br />시뮬레이터</> : <>BROKE RIDER<br />SIMULATOR</>}</h2><div><p>{ko ? <>남의 저녁을 배달해서,<br />내일의 생활비를 법니다.</> : <>Deliver someone’s dinner.<br />Earn tomorrow’s living.</>}</p><a class="round-link" href={`/${lang}/games/broke-rider-simulator/`}>{ko ? '게임 살펴보기' : 'Meet the game'}<span aria-hidden="true">↗</span></a></div></div>
  <figure class="world-art"><img src="/images/rebrand/delivery-world.webp" width="1536" height="1024" loading="lazy" alt={ko ? '파란 배달 가방을 멘 자전거 기사가 미니어처 도시를 달리는 콘셉트 아트' : 'Concept art of a bicycle courier with a blue delivery bag in a miniature city'} /><figcaption>{ko ? '웹사이트용 콘셉트 아트입니다. 실제 게임 화면이 아닙니다.' : 'Concept art for this website. Not an in-game screenshot.'}</figcaption></figure>
  <div class="game-summary"><h3>{ko ? '오늘도 한 건 더.' : 'Just one more delivery.'}</h3><p>{ko ? '실제 배달 경험에서 출발한 1인칭 배달 게임입니다. 현실의 지도 위에서 주문을 받고, 골목을 달리고, 생활비와 빚을 감당합니다. 현재 개발 중이며 출시 일정은 아직 정해지지 않았습니다.' : 'A first-person delivery game born from real delivery work. Take orders, ride streets built from real map data, and keep up with bills and debt. Currently in development, with no release date set.'}</p></div>
</section>
<section class="notebook"><div class="notebook-heading"><h2>{ko ? '만드는 중에.' : 'While we’re making.'}</h2><a class="text-link" href={`/${lang}/devlog/`}>{ko ? '개발 일지 전체' : 'All development notes'} ↗</a></div><PostCards {posts} {lang} /></section>
<section class="studio-outro"><p>{ko ? '팀 메추리알' : 'Team Mechureal'}</p><h2>{ko ? <>우리도 하고 싶은 게임.<br />그래서 직접 만듭니다.</> : <>Games we want to play.<br />So we’re making them.</>}</h2><div><p>{ko ? <>배달하던 경험이 게임이 되기도 합니다.<br />일상에서 발견한 재미를, 우리가 만드는 세계로.</> : <>Sometimes a delivery job becomes a game.<br />Everyday life, turned into worlds to play in.</>}</p><a class="round-link" href={`/${lang}/about/`}>{ko ? '메추리알 소개' : 'About the team'}<span aria-hidden="true">↗</span></a></div></section>
<script>
const story = document.querySelector<HTMLElement>('.egg-story');
if (story) {
 const reduced = matchMedia('(prefers-reduced-motion: reduce)');
 let raf = 0;
 const paint = () => {
  raf = 0;
  const p = Math.max(0, Math.min(1, -story.getBoundingClientRect().top / Math.max(1, story.offsetHeight - innerHeight + 76)));
  const split = Math.max(0, Math.min(1, (p - .12) / .66));
  story.style.setProperty('--travel', `${split * 90}vw`);
  story.style.setProperty('--lift', `${split * 45}vh`);
  story.style.setProperty('--turn', `${split * 50}deg`);
  story.style.setProperty('--intro', String(1 - Math.min(1, p * 4)));
  story.style.setProperty('--world', String(Math.min(1, split * 2)));
  story.style.setProperty('--egg-opacity', String(1 - Math.max(0, (split - .6) / .4)));
 };
 const schedule = () => { if (!raf && !reduced.matches) raf = requestAnimationFrame(paint); };
 const configure = () => { story.classList.toggle('motion-ready', !reduced.matches); schedule(); };
 addEventListener('scroll', schedule, { passive:true });
 addEventListener('resize', schedule, { passive:true });
 reduced.addEventListener('change', configure);
 configure();
}
</script>
