---
import PostCards from './PostCards.astro';
import type { Lang, Post } from '../lib/content';
interface Props { lang: Lang; posts: Post[]; }
const { lang, posts } = Astro.props;
const ko = lang === 'ko';
---
<section class="egg-story" aria-label={ko ? '메추리알에서 시작하는 게임' : 'Games begin inside a quail egg'}>
 <div class="egg-stage">
  <div class="studio-intro"><h1>mechureal</h1></div>
  <div class="egg-object" aria-hidden="true"><div class="egg-shadow"></div><img class="egg-piece egg-upper" src="/images/pink-studio/oval-quail-egg.webp" alt="" width="1000" height="1094" fetchpriority="high" /><img class="egg-piece egg-lower" src="/images/pink-studio/oval-quail-egg.webp" alt="" width="1000" height="1094" fetchpriority="high" /></div>
  <div class="inner-world" aria-hidden="true"><img src="/images/pink-studio/delivery-city.webp" width="1536" height="1024" alt="" /><strong>{ko ? '딸배 시뮬레이터' : 'BROKE RIDER SIMULATOR'}</strong><small>{ko ? '콘셉트 아트 · 실제 게임 화면이 아닙니다' : 'Concept art · Not an in-game screenshot'}</small></div>
  <div class="hero-foot"><p>{ko ? <>게임을 만드는 작은 팀,<br />메추리알입니다.</> : <>A small team making games.<br />We’re Mechureal.</>}</p><a class="egg-scroll" href="#games">{ko ? '스크롤해서 알 속으로' : 'Scroll to crack it open'} <span aria-hidden="true">↓</span></a></div>
 </div>
</section>
<section class="game-world" id="games">
  <div class="game-title-row"><h2>{ko ? <>딸배<br />시뮬레이터</> : <>BROKE RIDER<br />SIMULATOR</>}</h2><div><p>{ko ? <>익숙한 도시가,<br />오늘의 일터가 됩니다.</> : <>Familiar streets.<br />A new day on the job.</>}</p><a class="round-link" href={`/${lang}/games/broke-rider-simulator/`}>{ko ? '게임 살펴보기' : 'Meet the game'}<span aria-hidden="true">↗</span></a></div></div>
  <figure class="world-art"><img src="/images/pink-studio/delivery-city.webp" width="1536" height="1024" loading="lazy" alt={ko ? '분홍빛 저녁 하늘 아래 배달 스쿠터가 세워진 도시 골목의 콘셉트 아트' : 'Concept art of a delivery scooter parked on a city street beneath a pink evening sky'} /><figcaption>{ko ? '웹사이트용 콘셉트 아트입니다. 실제 게임 화면이 아닙니다.' : 'Concept art for this website. Not an in-game screenshot.'}</figcaption></figure>
  <div class="game-summary"><h3>{ko ? '길을 익히고, 배달을 마치고.' : 'Learn the streets. Make the delivery.'}</h3><p>{ko ? '실제 배달 경험에서 출발한 1인칭 배달 게임입니다. 현실의 지도 위에서 주문을 받고, 골목을 달리고, 생활비와 빚을 감당합니다. 현재 개발 중이며 출시 일정은 아직 정해지지 않았습니다.' : 'A first-person delivery game born from real delivery work. Take orders, ride streets built from real map data, and keep up with bills and debt. Currently in development, with no release date set.'}</p></div>
</section>
<section class="scooter-crossing" aria-label={ko ? '배달 경험에서 시작한 게임' : 'A game born from delivery work'}>
 <div class="crossing-stage"><div class="crossing-copy"><h2>{ko ? <>직접 달려본 길에서<br />시작했습니다.</> : <>It started with<br />a real delivery job.</>}</h2><p>{ko ? '배달을 하며 익힌 길과 일상의 작은 사건들을 게임에 옮기고 있습니다.' : 'The streets we learned and the small things that happened along the way are finding their way into our game.'}</p></div><div class="scooter-lane" aria-hidden="true"><div class="lane-line"></div><img class="passing-scooter" src="/images/pink-studio/delivery-scooter.webp" width="1000" height="563" alt="" loading="lazy" /></div></div>
</section>
<section class="notebook"><div class="notebook-heading"><h2>{ko ? '만드는 중에.' : 'While we’re making.'}</h2><a class="text-link" href={`/${lang}/devlog/`}>{ko ? '개발 일지 전체' : 'All development notes'} ↗</a></div><PostCards {posts} {lang} /></section>
<section class="studio-outro"><p>{ko ? '팀 메추리알' : 'Team Mechureal'}</p><h2>{ko ? <>우리도 하고 싶은 게임.<br />그래서 직접 만듭니다.</> : <>Games we want to play.<br />So we’re making them.</>}</h2><div><p>{ko ? <>배달하던 경험이 게임이 되기도 합니다.<br />일상에서 발견한 재미를, 우리가 만드는 세계로.</> : <>Sometimes a delivery job becomes a game.<br />Everyday life, turned into worlds to play in.</>}</p><a class="round-link" href={`/${lang}/about/`}>{ko ? '메추리알 소개' : 'About the team'}<span aria-hidden="true">↗</span></a></div></section>
<script>
import { clamp, eggProgress, scooterProgress } from '../lib/scroll-motion';
const story = document.querySelector<HTMLElement>('.egg-story');
const crossing = document.querySelector<HTMLElement>('.scooter-crossing');
if (story && crossing) {
 const reduced = matchMedia('(prefers-reduced-motion: reduce)');
 let raf = 0;
 const paint = () => {
  raf = 0;
  const header = document.querySelector<HTMLElement>('.site-header')?.offsetHeight ?? 76;
  const p = eggProgress(story.getBoundingClientRect().top, story.offsetHeight, innerHeight, header);
  const split = clamp((p - .12) / .66);
  story.style.setProperty('--travel', `${split * 63}vw`);
  story.style.setProperty('--lift', `${split * 29}vh`);
  story.style.setProperty('--turn', `${split * 40}deg`);
  story.style.setProperty('--intro', String(1 - clamp(p * 4)));
  story.style.setProperty('--world', String(clamp(split * 2)));
  story.style.setProperty('--egg-opacity', String(1 - clamp((split - .65) / .35)));
  const ride = scooterProgress(crossing.getBoundingClientRect().top, crossing.offsetHeight, innerHeight);
  crossing.style.setProperty('--ride-x', `${-75 + ride * 220}vw`);
 };
 const schedule = () => { if (!raf && !reduced.matches) raf = requestAnimationFrame(paint); };
 const configure = () => {
  story.classList.toggle('motion-ready', !reduced.matches);
  crossing.classList.toggle('motion-ready', !reduced.matches);
  if (reduced.matches && raf) { cancelAnimationFrame(raf); raf = 0; }
  schedule();
 };
 addEventListener('scroll', schedule, { passive:true });
 addEventListener('resize', schedule, { passive:true });
 reduced.addEventListener('change', configure);
 configure();
}
</script>
