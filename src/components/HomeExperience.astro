---
import QuailEgg from './QuailEgg.astro';
import PostCards from './PostCards.astro';
import { copy } from '../lib/i18n';
import type { Lang, Post } from '../lib/content';
interface Props { lang: Lang; posts: Post[]; }
const { lang, posts } = Astro.props;
const ko = lang === 'ko';
const t = copy[lang];
---
<div class="home-experience">
  <section class="hatch-story" aria-label={ko ? '메추리알에서 나오는 게임' : 'Games inside a quail egg'}>
    <div class="hatch-stage">
      <div class="hatch-heading"><h1>mechureal<span class="wordmark-dot">.</span></h1><p>{ko ? '작은 알. 만드는 건 게임.' : 'Small egg. Games inside.'}</p></div>
      <div class="hatch-art" aria-hidden="true">
        <div class="egg-orbit"></div>
        <div class="hatch-window"><img src="/images/delivery-ride-concept.png" width="1672" height="941" alt="" fetchpriority="high" /><span>{ko ? '딸배 시뮬레이터' : 'BROKE RIDER SIMULATOR'}</span></div>
        <div class="shell shell-top"><QuailEgg part="top" /></div>
        <div class="shell shell-bottom"><QuailEgg part="bottom" /></div>
      </div>
      <div class="hatch-bottom"><p>{ko ? <>만들고 싶은 게임을 직접 만듭니다.<br />인디 게임팀, 메추리알.</> : <>Making the games we want to play.<br />An indie game team. A little offbeat.</>}</p><a class="hatch-cue" href="#our-game"><span>{ko ? '스크롤하면, 알이 깨집니다.' : 'Scroll to crack it open.'}</span><span aria-hidden="true">↓</span></a></div>
      <p class="hatch-caption">{t.concept}</p>
    </div>
  </section>

  <section class="delivery-world" id="our-game" aria-labelledby="delivery-title">
    <div class="delivery-heading"><h2 id="delivery-title">{ko ? <>딸배<br />시뮬레이터</> : <>BROKE RIDER<br />SIMULATOR</>}</h2><p>{ko ? <>음식은 식고,<br />이자는 붙고.</> : <>Food gets cold.<br />Debt gets bigger.</>}</p></div>
    <div class="delivery-layout">
      <figure class="delivery-photo"><img src="/images/delivery-ride-concept.png" width="1672" height="941" alt={ko ? '해 질 무렵 골목을 자전거로 달리는 배달 기사 콘셉트 일러스트' : 'Concept illustration of a delivery rider cycling down a neighborhood street at sunset'} loading="lazy" /><figcaption>{t.concept}</figcaption></figure>
      <div class="delivery-receipt"><h3>{ko ? '오늘도 배달로 갚습니다.' : 'Another day. Another delivery.'}</h3><p>{ko ? '개발자의 실제 배달 경험에서 시작한 1인칭 배달 게임. 현실의 지도 위에서 골목을 누비고, 배달비를 모아 생활비와 빚을 감당합니다.' : 'A first-person delivery game born from the developer’s own delivery work. Ride streets built from real map data and earn your way through bills and debt.'}</p><dl><div><dt>{ko ? '주문 내역' : 'Your order'}</dt><dd>{ko ? '배달 · 생활 · 코미디' : 'Delivery · Life · Comedy'}</dd></div><div><dt>{ko ? '현재 진행' : 'In the kitchen'}</dt><dd>{ko ? '개발 중' : 'In development'}</dd></div><div><dt>{ko ? '출시일' : 'Ready by'}</dt><dd>{ko ? '아직 미정' : 'To be announced'}</dd></div></dl><a class="receipt-link" href={`/${lang}/games/broke-rider-simulator/`}>{t.explore}<span aria-hidden="true">↗</span></a><p class="receipt-note">{ko ? '공개 빌드는 아직 없습니다. 지금은 만드는 중입니다.' : 'No public build just yet. We’re still cooking.'}</p><div class="receipt-bars" aria-hidden="true"></div></div>
    </div>
  </section>

  <section class="home-notes"><div class="notes-intro"><h2>{ko ? <>알 속에서<br />일어나는 일.</> : <>Inside<br />the shell.</>}</h2><p>{ko ? '지도를 만들고, 배달을 붙이고, 다시 고칩니다. 게임을 만드는 과정의 기록입니다.' : 'Building streets, making deliveries work, then trying again. Notes from making our game.'}</p><a class="text-link" href={`/${lang}/devlog/`}>{t.all} <span aria-hidden="true">↗</span></a></div><PostCards {posts} {lang} /></section>
  <section class="home-team"><div class="team-egg"><QuailEgg /></div><div><h2>{ko ? '메추리알은 팀 이름입니다.' : 'Yes, we’re named after a quail egg.'}</h2><p>{t.intro}</p><a class="text-link" href={`/${lang}/about/`}>{ko ? '팀 소개' : 'Meet the team'} <span aria-hidden="true">↗</span></a><a class="text-link" href={`/${lang}/contact/`}>{ko ? '연락하기' : 'Get in touch'} <span aria-hidden="true">↗</span></a></div></section>
</div>
<script>
  const story = document.querySelector<HTMLElement>('.hatch-story');
  if (story) {
    const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let frame = 0;
    const update = () => {
      frame = 0;
      const distance = story.offsetHeight - window.innerHeight + 80;
      const progress = Math.max(0, Math.min(1, -story.getBoundingClientRect().top / distance));
      const crack = Math.max(0, Math.min(1, (progress - .08) / .7));
      story.style.setProperty('--crack', String(crack));
      story.style.setProperty('--shell-x', `${crack * 78}vw`);
      story.style.setProperty('--shell-y', `${crack * 24}vh`);
      story.style.setProperty('--shell-turn', `${crack * 48}deg`);
      story.style.setProperty('--shell-opacity', String(1 - Math.max(0, (crack - .7) / .3)));
      story.style.setProperty('--reveal', String(Math.min(1, crack * 2.5)));
      story.style.setProperty('--art-scale', String(.78 + crack * .22));
      story.style.setProperty('--intro-opacity', String(1 - Math.min(1, crack * 2)));
    };
    const schedule = () => { if (!frame) frame = requestAnimationFrame(update); };
    const configure = () => {
      story.classList.toggle('is-animated', !motion.matches);
      if (!motion.matches) schedule();
    };
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule, { passive: true });
    motion.addEventListener('change', configure);
    configure();
  }
</script>
