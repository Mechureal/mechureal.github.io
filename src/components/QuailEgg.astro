---
interface Props { part?: 'whole' | 'top' | 'bottom'; }
const { part = 'whole' } = Astro.props;
const outline = 'M240 16C152 16 48 193 48 316C48 440 128 504 240 504C352 504 432 440 432 316C432 193 328 16 240 16Z';
const spots = Array.from({ length: 76 }, (_, i) => {
  const x = 55 + ((i * 137.508) % 370);
  const y = 28 + ((i * 83.13) % 470);
  const r = 3 + ((i * 7.31) % 14);
  return { x, y, r, rotate: (i * 67) % 360 };
});
const id = `egg-${part}`;
---
<svg viewBox="0 0 480 520" fill="none" aria-hidden="true" class:list={['quail-egg', `quail-egg-${part}`]}>
  <defs>
    <clipPath id={`${id}-outline`}><path d={outline} /></clipPath>
    <clipPath id={`${id}-split`}><path d={part === 'top' ? 'M0 0H480V262L405 276L364 241L320 280L278 246L230 288L184 251L141 283L96 250L48 276L0 260Z' : 'M0 520H480V262L405 276L364 241L320 280L278 246L230 288L184 251L141 283L96 250L48 276L0 260Z'} /></clipPath>
  </defs>
  <g clip-path={part === 'whole' ? undefined : `url(#${id}-split)`}>
    <path d={outline} fill="#f3e8ce" stroke="#292c23" stroke-width="3" />
    <g clip-path={`url(#${id}-outline)`} fill="#454438">
      {spots.map(({ x, y, r, rotate }) => <path d="M-1-1C-8-9-13-4-10 2C-15 9-4 12 0 7C6 13 14 5 8 0C12-7 3-10-1-1Z" transform={`translate(${x} ${y}) rotate(${rotate}) scale(${r / 10} ${r / 12})`} />)}
    </g>
    {part !== 'whole' && <path d="M48 276L96 250L141 283L184 251L230 288L278 246L320 280L364 241L405 276L432 271" stroke="#292c23" stroke-width="3" />}
  </g>
</svg>
