---
import '../styles/global.css';
import { copy } from '../lib/i18n';
import type { Lang } from '../lib/content';
interface Props { lang: Lang; title: string; description: string; alternate?: string; fallback?: boolean; article?: boolean; date?: Date; updated?: Date; image?: string; noindex?: boolean; }
const { lang, title, description, alternate, fallback, article, date, updated, image = '/images/social.png', noindex } = Astro.props;
const t = copy[lang];
const other = lang === 'ko' ? 'en' : 'ko';
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site);
const alternatePath = noindex ? `/${other}/` : alternate || path.replace(`/${lang}/`, `/${other}/`);
const sections = ['', 'games/', 'devlog/', 'about/', 'contact/'];
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width" />
    <title>{title} | Mechureal</title><meta name="description" content={description} />
    <meta name="author" content="Mechureal" /><meta name="theme-color" content="#101217" />
    <link rel="icon" type="image/png" href="/images/mechureal-egg.png" />
    <link rel="canonical" href={canonical} />
    {!noindex && <link rel="alternate" hreflang={lang} href={canonical} />}
    {!noindex && !fallback && <link rel="alternate" hreflang={other} href={new URL(alternatePath, Astro.site)} />}
    {!noindex && <link rel="alternate" hreflang="x-default" href={new URL(lang === 'ko' ? path : fallback ? path : alternatePath, Astro.site)} />}
    <link rel="alternate" type="application/rss+xml" title={`Mechureal Devlog (${lang})`} href={`/${lang}/rss.xml`} />
    <meta property="og:site_name" content="Mechureal" /><meta property="og:title" content={`${title} | Mechureal`} />
    <meta property="og:description" content={description} /><meta property="og:url" content={canonical} />
    <meta property="og:type" content={article ? 'article' : 'website'} /><meta property="og:locale" content={lang === 'ko' ? 'ko_KR' : 'en_US'} />
    <meta property="og:image" content={new URL(image, Astro.site)} /><meta property="og:image:alt" content="Mechureal — Independent Game Studio" />
    <meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={`${title} | Mechureal`} /><meta name="twitter:description" content={description} /><meta name="twitter:image" content={new URL(image, Astro.site)} />
    {date && <meta property="article:published_time" content={date.toISOString()} />}{updated && <meta property="article:modified_time" content={updated.toISOString()} />}
    {noindex && <meta name="robots" content="noindex" />}
  </head>
  <body>
    <a class="skip" href="#main">{t.skip}</a>
    <header class="site-header"><div class="nav-wrap">
      <a class="brand" href={`/${lang}/`} aria-label="Mechureal"><img class="brand-egg" src="/images/mechureal-egg.png" width="42" height="42" alt="" />MECHUREAL</a>
      <nav class="desktop-nav" aria-label={lang === 'ko' ? '주 메뉴' : 'Main navigation'}>{sections.map((section, i) => <a aria-current={path === `/${lang}/${section}` || (section && path.startsWith(`/${lang}/${section}`)) ? 'page' : undefined} href={`/${lang}/${section}`}>{t.nav[i]}</a>)}</nav>
      <a class="language" href={alternatePath} lang={other} title={fallback ? t.switchFallback : undefined}>{lang === 'ko' ? 'EN' : '한국어'} <span aria-hidden="true">↗</span></a>
      <details class="mobile-menu"><summary aria-label={lang === 'ko' ? '메뉴' : 'Menu'}>☰</summary><nav aria-label={lang === 'ko' ? '모바일 메뉴' : 'Mobile navigation'}>{sections.map((section, i) => <a href={`/${lang}/${section}`}>{t.nav[i]}</a>)}</nav></details>
    </div></header>
    <main id="main"><slot /></main>
    <footer class="site-footer"><div><a class="brand" href={`/${lang}/`}><img class="brand-egg" src="/images/mechureal-egg.png" width="36" height="36" alt="" />MECHUREAL</a><p>{t.footer}</p></div><div class="footer-links"><a href={`/${lang}/contact/`}>{t.nav[4]}</a><a href={`/${lang}/rss.xml`}>RSS ↗</a><a href="https://github.com/Mechureal">GitHub ↗</a></div><p class="copyright">© {new Date().getUTCFullYear()} Mechureal</p></footer>
  </body>
</html>
